// Native transport for the Fe conformance checker (protocol version 3).
//
// Input: whitespace-separated unsigned decimals, at most 65,536 characters and
// 78 digits per number, ending at EOF. The first two numbers are `3 <kind>`.
//
// kind 1, sequence comparison:
//   table(left) table(right) deployment(left) deployment(right) steps,
//   then per step: allowlist exact(0|1) observation(left) observation(right)
//   table:       count (address role)*count                    (count <= 8)
//   allowlist:   count (field log word)*count, field 0 return, 1 topic, 2 data (count <= 16)
//   observation: success payload log_count log* state_count (kind value)*
//                log:     emitter topic_count topic* payload
//                payload: len word*ceil(len/32)
//                state kind: 0 uint, 1 int (two's complement), 2 address, 3 bool, 4 word
//   Lengths and counts above the observation limits (256-byte payloads, 4 logs,
//   4 topics, 8 state fields) are still read, up to the frame bound. Fe then
//   reports them as malformed with a reason, instead of truncating them.
//   reply: `3 1 verdict steps total listed reason` record, then `listed` more records.
//   record: deployment step category log index slot left right
//   verdict: 0 match, 1 mismatch, 2 malformed, 3 not comparable (deployment failed)
// kind 2, ABI validation:
//   layout with_selector(0|1) selector payload; layout: count (kind bits)*count,
//   kind 0 uint, 1 int, 2 address, 3 bool, 4 bytes (count <= 8). reply: `3 2 category index`.
// Exit 2 means an invalid frame (nothing is written); exit 3 means an output failure.
use std::io::{Read, Write, host}
use compat::{
    CallObservation,
    Payload,
    StateKind,
    StateField,
    Verdict,
    Mismatch,
    AddressTable,
    Allowlist,
    Position,
    Field,
    Layout,
    Slot,
    SlotKind,
    AbiResult,
    MAX_PAYLOAD_WORDS,
    MAX_LOGS,
    MAX_TOPICS,
    MAX_STEPS,
    MAX_ROLES,
    MAX_POSITIONS,
    MAX_SLOTS,
    MAX_STATE,
    MAX_LISTED,
    empty_payload,
    empty_log,
    empty_observation,
    empty_table,
    empty_allowlist,
    empty_layout,
    begin_deployed,
    step_normalized,
    category_code,
    malformation_code,
    abi_code,
    validate,
    PackedField,
    FieldKind,
    Schema,
    LayoutResult,
    SlotWord,
    Entry,
    empty_schema,
    empty_layout_step,
    validate_schema,
    check_step,
    layout_code,
}

struct Parser { bad: bool, chars: usize }

fn next_char() -> i32 uses (input: mut Read, parser: mut Parser) {
    if parser.chars >= 65536 {
        parser.bad = true
        return -1
    }
    parser.chars += 1
    input.read_char()
}

fn whitespace(c: i32) -> bool {
    c == 32 || c == 10 || c == 13 || c == 9
}

fn read_number() -> u256 uses (input: mut Read, parser: mut Parser) {
    if parser.bad {
        return 0
    }
    var c = next_char()
    while whitespace(c) {
        c = next_char()
    }
    var value: u256 = 0
    var digits: usize = 0
    while c >= 48 && c <= 57 {
        let digit: u256 = (c - 48).downcast().unwrap()
        if digits >= 78 || value > (!(0 as u256) - digit) / 10 {
            parser.bad = true
            return 0
        }
        value = value * 10 + digit
        digits += 1
        c = next_char()
    }
    if digits == 0 || (c != -1 && !whitespace(c)) {
        parser.bad = true
    }
    value
}

fn read_small(limit: u256) -> usize uses (input: mut Read, parser: mut Parser) {
    let value = read_number()
    if value > limit {
        parser.bad = true
        return 0
    }
    value as usize
}

// Words beyond the observation limit are consumed but not stored; the declared
// length is kept, so Fe classifies the payload as oversized.
fn read_payload() -> Payload uses (input: mut Read, parser: mut Parser) {
    var payload = empty_payload()
    payload.len = read_small(limit: 65536)
    var w: usize = 0
    while w * 32 < payload.len && !parser.bad {
        let word = read_number()
        if w < MAX_PAYLOAD_WORDS {
            payload.words[w] = word
        }
        w += 1
    }
    payload
}

fn read_log() -> compat::LogRecord uses (input: mut Read, parser: mut Parser) {
    var log = empty_log()
    log.emitter = read_number()
    log.topic_count = read_small(limit: 64)
    var t: usize = 0
    while t < log.topic_count && !parser.bad {
        let topic = read_number()
        if t < MAX_TOPICS {
            log.topics[t] = topic
        }
        t += 1
    }
    log.data = read_payload()
    log
}

fn read_kind() -> StateKind uses (input: mut Read, parser: mut Parser) {
    let tag = read_small(limit: 4)
    if tag == 0 {
        StateKind::Uint
    } else if tag == 1 {
        StateKind::Int
    } else if tag == 2 {
        StateKind::Address
    } else if tag == 3 {
        StateKind::Bool
    } else {
        StateKind::Word
    }
}

fn read_observation() -> CallObservation uses (input: mut Read, parser: mut Parser) {
    var observation = empty_observation()
    observation.success = read_small(limit: 1) == 1
    observation.returndata = read_payload()
    observation.log_count = read_small(limit: 64)
    var i: usize = 0
    while i < observation.log_count && !parser.bad {
        let log = read_log()
        if i < MAX_LOGS {
            observation.logs[i] = log
        }
        i += 1
    }
    observation.state_count = read_small(limit: 64)
    var s: usize = 0
    while s < observation.state_count && !parser.bad {
        let kind = read_kind()
        let value = read_number()
        if s < MAX_STATE {
            observation.state[s] = StateField { kind, value }
        }
        s += 1
    }
    observation
}

fn finish_input() uses (input: mut Read, parser: mut Parser) {
    var c = next_char()
    while c != -1 {
        if !whitespace(c) {
            parser.bad = true
        }
        c = next_char()
    }
}

fn read_table() -> AddressTable uses (input: mut Read, parser: mut Parser) {
    var table = empty_table()
    table.count = read_small(limit: MAX_ROLES as u256)
    var i: usize = 0
    while i < table.count && !parser.bad {
        table.addresses[i] = read_number()
        table.roles[i] = read_number()
        i += 1
    }
    table
}

fn read_allowlist() -> Allowlist uses (input: mut Read, parser: mut Parser) {
    var allowlist = empty_allowlist()
    allowlist.count = read_small(limit: MAX_POSITIONS as u256)
    var i: usize = 0
    while i < allowlist.count && !parser.bad {
        let tag = read_small(limit: 2)
        let field = if tag == 0 {
            Field::Return
        } else if tag == 1 {
            Field::Topic
        } else {
            Field::Data
        }
        let log = read_small(limit: 255)
        let word = read_small(limit: 255)
        allowlist.positions[i] = Position { field, log, word }
        i += 1
    }
    allowlist
}

fn read_layout() -> Layout uses (input: mut Read, parser: mut Parser) {
    var layout = empty_layout()
    layout.count = read_small(limit: MAX_SLOTS as u256)
    var i: usize = 0
    while i < layout.count && !parser.bad {
        let tag = read_small(limit: 4)
        let kind = if tag == 0 {
            SlotKind::Uint
        } else if tag == 1 {
            SlotKind::Int
        } else if tag == 2 {
            SlotKind::Address
        } else if tag == 3 {
            SlotKind::Bool
        } else {
            SlotKind::Bytes
        }
        let bits = read_small(limit: 256)
        layout.slots[i] = Slot { kind, bits }
        i += 1
    }
    layout
}

struct Reply { kind: u256, steps: usize, progress: compat::Progress, abi: AbiResult, layout: LayoutResult }

// Counts above the schema limits (8 fields, 2 roots) are read but not stored,
// so Fe reports them as too many instead of rejecting the frame.
fn read_schema() -> Schema uses (input: mut Read, parser: mut Parser) {
    var schema = empty_schema()
    schema.fields = read_small(limit: 64)
    var i: usize = 0
    while i < schema.fields && !parser.bad {
        let slot = read_number()
        let offset = read_small(limit: 255)
        let bytes = read_small(limit: 255)
        let tag = read_small(limit: 2)
        let kind = if tag == 0 { FieldKind::Uint } else if tag == 1 { FieldKind::Address } else { FieldKind::Bool }
        if i < 8 {
            schema.field[i] = PackedField { slot, offset, bytes, kind }
        }
        i += 1
    }
    schema.roots = read_small(limit: 64)
    var r: usize = 0
    while r < schema.roots && !parser.bad {
        let root = read_number()
        if r < 2 {
            schema.root[r] = root
        }
        r += 1
    }
    schema
}

fn read_layout_step(fields: usize) -> compat::LayoutStep uses (input: mut Read, parser: mut Parser) {
    var step = empty_layout_step()
    step.words = read_small(limit: 4)
    var i: usize = 0
    while i < step.words && !parser.bad {
        let slot = read_number()
        let before = read_number()
        let after = read_number()
        step.word[i] = SlotWord { slot, before, after }
        i += 1
    }
    step.written = read_small(limit: 255)
    var f: usize = 0
    while f < fields && !parser.bad {
        let value = read_number()
        if f < 8 {
            step.expected[f] = value
        }
        f += 1
    }
    step.entries = read_small(limit: 4)
    var e: usize = 0
    while e < step.entries && !parser.bad {
        let slot = read_number()
        let observed = read_number()
        let expected = read_number()
        step.entry[e] = Entry { slot, observed, expected }
        e += 1
    }
    step.writes = read_small(limit: 8)
    var w: usize = 0
    while w < step.writes && !parser.bad {
        step.write[w] = read_number()
        w += 1
    }
    step
}

fn route() -> Reply uses (input: mut Read, parser: mut Parser) {
    let left_table = empty_table()
    var reply = Reply {
        kind: 0,
        steps: 0,
        progress: compat::begin(),
        abi: validate(payload: empty_payload(), layout: empty_layout(), selector: 0, with_selector: false),
        layout: validate_schema(empty_schema()),
    }
    if read_number() != 3 {
        parser.bad = true
        return reply
    }
    reply.kind = read_number()
    if reply.kind == 1 {
        let left_table = read_table()
        let right_table = read_table()
        let deploy_left = read_observation()
        let deploy_right = read_observation()
        var progress = begin_deployed(left: deploy_left, right: deploy_right, left_table, right_table)
        let count = read_small(limit: MAX_STEPS as u256)
        var s: usize = 0
        while s < count && !parser.bad {
            let allowlist = read_allowlist()
            let exact = read_small(limit: 1) == 1
            let left = read_observation()
            let right = read_observation()
            progress = step_normalized(progress, left, right, left_table, right_table, allowlist,
                                       exact_returndata: exact)
            s += 1
        }
        reply.steps = progress.steps
        reply.progress = progress
    } else if reply.kind == 2 {
        let layout = read_layout()
        let with_selector = read_small(limit: 1) == 1
        let selector = read_number()
        let payload = read_payload()
        reply.abi = validate(payload, layout, selector, with_selector)
    } else if reply.kind == 4 {
        let schema = read_schema()
        var current = validate_schema(schema)
        let count = read_small(limit: 64)
        var s: usize = 0
        while s < count && !parser.bad {
            let step = read_layout_step(fields: schema.fields)
            if layout_code(current.category) == 0 {
                current = check_step(schema, step)
                current.step = s
            }
            s += 1
        }
        reply.steps = count
        reply.layout = current
    } else {
        parser.bad = true
    }
    finish_input()
    reply
}
fn number(_ n: u256) uses (output: mut Write) {
    var value = n
    var digits: [u8; 78] = [0; 78]
    var len: usize = 0
    if value == 0 {
        output.write_char(c: 48)
    }
    while value != 0 {
        let digit: u8 = (value % 10).downcast().unwrap()
        digits[len] = digit + 48
        len += 1
        value /= 10
    }
    while len > 0 {
        len -= 1
        output.write_char(c: digits[len] as i32)
    }
    output.write_char(c: 32)
}

fn write_record(m: Mismatch) uses (output: mut Write) {
    number(if m.deployment { 1 } else { 0 })
    number(m.step as u256)
    number(
        match m.verdict {
            Verdict::Mismatch => category_code(m.category),
            _ => 0,
        },
    )
    number(m.log as u256)
    number(m.index as u256)
    number(m.slot as u256)
    number(m.left)
    number(m.right)
}

fn write_reply(reply: Reply) uses (output: mut Write) {
    number(3)
    number(reply.kind)
    if reply.kind == 4 {
        number(layout_code(reply.layout.category))
        number(reply.layout.step as u256)
        number(reply.layout.index as u256)
        number(reply.layout.left)
        number(reply.layout.right)
        output.write_char(c: 10)
        return
    }
    if reply.kind == 2 {
        number(abi_code(reply.abi.category))
        number(reply.abi.index as u256)
        output.write_char(c: 10)
        return
    }
    let progress = reply.progress
    let m = progress.result
    number(
        match m.verdict {
            Verdict::Match => 0,
            Verdict::Mismatch => 1,
            Verdict::Malformed => 2,
            Verdict::NotComparable => 3,
        },
    )
    number(reply.steps as u256)
    number(progress.total as u256)
    number(progress.listed as u256)
    number(malformation_code(m.reason))
    write_record(m)
    var i: usize = 0
    while i < progress.listed {
        write_record(m: progress.mismatches[i])
        i += 1
    }
    output.write_char(c: 10)
}

pub fn main() -> i32 {
    var channel = host()
    var parser = Parser { bad: false, chars: 0 }
    let reply = with (Read = mut channel, mut parser) {
        route()
    }
    if parser.bad {
        return 2
    }
    with (Write = mut channel) {
        write_reply(reply)
    }
    if channel.failed() {
        return 3
    }
    0
}
