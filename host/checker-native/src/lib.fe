// Native transport for the Fe conformance checker (protocol version 2).
//
// Input: whitespace-separated unsigned decimals, at most 65,536 characters and
// 78 digits per number, ending at EOF. The first two numbers are `2 <kind>`.
//
// kind 1, sequence comparison:
//   table(left) table(right) deployment(left) deployment(right) steps,
//   then per step: allowlist exact(0|1) observation(left) observation(right)
//   table:       count (address role)*count                    (count <= 8)
//   allowlist:   count (field log word)*count, field 0 return, 1 topic, 2 data (count <= 16)
//   observation: success len word*ceil(len/32) log_count, then per log:
//                emitter topic_count topic*topic_count data_len word*ceil(data_len/32)
//   reply: `2 1 verdict steps deployment step category log index left right`, where
//   verdict is 0 match, 1 mismatch, 2 malformed, 3 not comparable (deployment failed).
// kind 2, ABI validation:
//   layout with_selector(0|1) selector payload
//   layout: count (kind bits)*count, kind 0 uint, 1 int, 2 address, 3 bool, 4 bytes (count <= 8)
//   payload: len word*ceil(len/32)
//   reply: `2 2 category index`
// Words are big-endian 32-byte chunks with a zero-padded tail. Exit 2 means an
// invalid frame (nothing is written); exit 3 means an output failure.
use std::io::{Read, Write, host}
use compat::{
    CallObservation,
    Payload,
    Verdict,
    Mismatch,
    AddressTable,
    Allowlist,
    Position,
    Field,
    Layout,
    Slot,
    SlotKind,
    AbiResult,
    MAX_PAYLOAD_WORDS,
    MAX_LOGS,
    MAX_TOPICS,
    MAX_STEPS,
    MAX_ROLES,
    MAX_POSITIONS,
    MAX_SLOTS,
    empty_payload,
    empty_log,
    empty_observation,
    empty_table,
    empty_allowlist,
    empty_layout,
    begin_deployed,
    step_normalized,
    category_code,
    abi_code,
    validate,
}

struct Parser { bad: bool, chars: usize }

fn next_char() -> i32 uses (input: mut Read, parser: mut Parser) {
    if parser.chars >= 65536 {
        parser.bad = true
        return -1
    }
    parser.chars += 1
    input.read_char()
}

fn whitespace(c: i32) -> bool {
    c == 32 || c == 10 || c == 13 || c == 9
}

fn read_number() -> u256 uses (input: mut Read, parser: mut Parser) {
    if parser.bad {
        return 0
    }
    var c = next_char()
    while whitespace(c) {
        c = next_char()
    }
    var value: u256 = 0
    var digits: usize = 0
    while c >= 48 && c <= 57 {
        let digit: u256 = (c - 48).downcast().unwrap()
        if digits >= 78 || value > (!(0 as u256) - digit) / 10 {
            parser.bad = true
            return 0
        }
        value = value * 10 + digit
        digits += 1
        c = next_char()
    }
    if digits == 0 || (c != -1 && !whitespace(c)) {
        parser.bad = true
    }
    value
}

fn read_small(limit: u256) -> usize uses (input: mut Read, parser: mut Parser) {
    let value = read_number()
    if value > limit {
        parser.bad = true
        return 0
    }
    value as usize
}

fn read_payload() -> Payload uses (input: mut Read, parser: mut Parser) {
    var payload = empty_payload()
    payload.len = read_small(limit: (MAX_PAYLOAD_WORDS * 32) as u256)
    var w: usize = 0
    while w * 32 < payload.len && !parser.bad {
        payload.words[w] = read_number()
        w += 1
    }
    payload
}

fn read_observation() -> CallObservation uses (input: mut Read, parser: mut Parser) {
    var observation = empty_observation()
    observation.success = read_small(limit: 1) == 1
    observation.returndata = read_payload()
    observation.log_count = read_small(limit: MAX_LOGS as u256)
    var i: usize = 0
    while i < observation.log_count && !parser.bad {
        var log = empty_log()
        log.emitter = read_number()
        log.topic_count = read_small(limit: MAX_TOPICS as u256)
        var t: usize = 0
        while t < log.topic_count && !parser.bad {
            log.topics[t] = read_number()
            t += 1
        }
        log.data = read_payload()
        observation.logs[i] = log
        i += 1
    }
    observation
}

fn finish_input() uses (input: mut Read, parser: mut Parser) {
    var c = next_char()
    while c != -1 {
        if !whitespace(c) {
            parser.bad = true
        }
        c = next_char()
    }
}

fn read_table() -> AddressTable uses (input: mut Read, parser: mut Parser) {
    var table = empty_table()
    table.count = read_small(limit: MAX_ROLES as u256)
    var i: usize = 0
    while i < table.count && !parser.bad {
        table.addresses[i] = read_number()
        table.roles[i] = read_number()
        i += 1
    }
    table
}

fn read_allowlist() -> Allowlist uses (input: mut Read, parser: mut Parser) {
    var allowlist = empty_allowlist()
    allowlist.count = read_small(limit: MAX_POSITIONS as u256)
    var i: usize = 0
    while i < allowlist.count && !parser.bad {
        let tag = read_small(limit: 2)
        let field = if tag == 0 {
            Field::Return
        } else if tag == 1 {
            Field::Topic
        } else {
            Field::Data
        }
        let log = read_small(limit: 255)
        let word = read_small(limit: 255)
        allowlist.positions[i] = Position { field, log, word }
        i += 1
    }
    allowlist
}

fn read_layout() -> Layout uses (input: mut Read, parser: mut Parser) {
    var layout = empty_layout()
    layout.count = read_small(limit: MAX_SLOTS as u256)
    var i: usize = 0
    while i < layout.count && !parser.bad {
        let tag = read_small(limit: 4)
        let kind = if tag == 0 {
            SlotKind::Uint
        } else if tag == 1 {
            SlotKind::Int
        } else if tag == 2 {
            SlotKind::Address
        } else if tag == 3 {
            SlotKind::Bool
        } else {
            SlotKind::Bytes
        }
        let bits = read_small(limit: 256)
        layout.slots[i] = Slot { kind, bits }
        i += 1
    }
    layout
}

struct Reply { kind: u256, steps: usize, result: Mismatch, abi: AbiResult }

fn route() -> Reply uses (input: mut Read, parser: mut Parser) {
    let left_table = empty_table()
    var reply = Reply {
        kind: 0,
        steps: 0,
        result: begin_deployed(left: empty_observation(), right: empty_observation(), left_table, right_table: left_table).result,
        abi: validate(payload: empty_payload(), layout: empty_layout(), selector: 0, with_selector: false),
    }
    if read_number() != 2 {
        parser.bad = true
        return reply
    }
    reply.kind = read_number()
    if reply.kind == 1 {
        let left_table = read_table()
        let right_table = read_table()
        let deploy_left = read_observation()
        let deploy_right = read_observation()
        var progress = begin_deployed(left: deploy_left, right: deploy_right, left_table, right_table)
        let count = read_small(limit: MAX_STEPS as u256)
        var s: usize = 0
        while s < count && !parser.bad {
            let allowlist = read_allowlist()
            let exact = read_small(limit: 1) == 1
            let left = read_observation()
            let right = read_observation()
            progress = step_normalized(progress, left, right, left_table, right_table, allowlist,
                                       exact_returndata: exact)
            s += 1
        }
        reply.steps = progress.steps
        reply.result = progress.result
    } else if reply.kind == 2 {
        let layout = read_layout()
        let with_selector = read_small(limit: 1) == 1
        let selector = read_number()
        let payload = read_payload()
        reply.abi = validate(payload, layout, selector, with_selector)
    } else {
        parser.bad = true
    }
    finish_input()
    reply
}
fn number(_ n: u256) uses (output: mut Write) {
    var value = n
    var digits: [u8; 78] = [0; 78]
    var len: usize = 0
    if value == 0 {
        output.write_char(c: 48)
    }
    while value != 0 {
        let digit: u8 = (value % 10).downcast().unwrap()
        digits[len] = digit + 48
        len += 1
        value /= 10
    }
    while len > 0 {
        len -= 1
        output.write_char(c: digits[len] as i32)
    }
    output.write_char(c: 32)
}

fn write_reply(reply: Reply) uses (output: mut Write) {
    number(2)
    number(reply.kind)
    if reply.kind == 2 {
        number(abi_code(reply.abi.category))
        number(reply.abi.index as u256)
        output.write_char(c: 10)
        return
    }
    let m = reply.result
    number(
        match m.verdict {
            Verdict::Match => 0,
            Verdict::Mismatch => 1,
            Verdict::Malformed => 2,
            Verdict::NotComparable => 3,
        },
    )
    number(reply.steps as u256)
    number(if m.deployment { 1 } else { 0 })
    number(m.step as u256)
    number(
        match m.verdict {
            Verdict::Mismatch => category_code(m.category),
            _ => 0,
        },
    )
    number(m.log as u256)
    number(m.index as u256)
    number(m.left)
    number(m.right)
    output.write_char(c: 10)
}

pub fn main() -> i32 {
    var channel = host()
    var parser = Parser { bad: false, chars: 0 }
    let reply = with (Read = mut channel, mut parser) {
        route()
    }
    if parser.bad {
        return 2
    }
    with (Write = mut channel) {
        write_reply(reply)
    }
    if channel.failed() {
        return 3
    }
    0
}
